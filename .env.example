# ============================================================
# Subscriptly — contoh konfigurasi environment
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# JANGAN commit file `.env` yang berisi rahasia asli.
# ============================================================

# --- Database -------------------------------------------------
# Mode lokal (default, langsung jalan tanpa server DB):
DATABASE_URL="file:./dev.db"

# Mode produksi (Supabase / PostgreSQL) — ganti provider di
# prisma/schema.prisma menjadi "postgresql" (lihat prisma/schema.postgresql.prisma)
# lalu isi connection string berikut:
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?schema=public&pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# --- Aplikasi -------------------------------------------------
# Dipakai untuk URL absolut, cookie, dan metadata.
APP_URL="http://localhost:3000"
TIMEZONE="Asia/Jakarta"
CURRENCY="IDR"

# --- Sesi & keamanan -----------------------------------------
# Wajib diisi di produksi (string acak minimal 32 karakter).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_NAME="subscriptly_session"
SESSION_TTL_DAYS="30"

# --- Data demo ------------------------------------------------
# Aktifkan pembuatan akun demo + data berlabel DEMO saat seeding.
SEED_DEMO_DATA="true"

# --- Billing --------------------------------------------------
# Provider pembayaran. "mock" = sandbox/demo internal (default).
# Belum ada gateway pembayaran yang terintegrasi pada prototype ini.
BILLING_PROVIDER="mock"

# Contoh bila kelak memakai Midtrans (JANGAN diisi di frontend):
# MIDTRANS_SERVER_KEY=""
# MIDTRANS_CLIENT_KEY=""
# MIDTRANS_IS_PRODUCTION="false"
# MIDTRANS_WEBHOOK_TOKEN=""

# Contoh bila kelak memakai Stripe:
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Verifikasi pelajar --------------------------------------
# "demo" = alur verifikasi demo (pending/approved/rejected manual).
# Belum ada provider verifikasi pihak ketiga yang terintegrasi.
STUDENT_VERIFICATION_PROVIDER="demo"
# STUDENT_VERIFICATION_API_KEY=""
